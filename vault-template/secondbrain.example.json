{
  "goalsFile": "Areas/goals.md",
  "missionFile": "Areas/mission.md",
  "map": {
    "divisionFolders": {
      "writing": ["Areas/blog", "Areas/newsletter"],
      "hardware": ["Areas/workshop"]
    },
    "missionFolders": ["Areas/goals.md", "Areas/mission.md"]
  },
  "metrics": [
    { "key": "followers.total", "label": "Followers (YouTube + X)", "unit": "followers", "goal": "Y1", "target": 10000,
      "headline": true, "sum": ["yt.example.subscribers", "x.example.followers"] },
    { "key": "yt.example.subscribers", "label": "YouTube @example", "unit": "subscribers", "goal": "Y1",
      "collect": { "type": "youtube", "handle": "example" } },
    { "key": "x.example.followers", "label": "X @example", "unit": "followers", "division": "writing",
      "collect": { "type": "x", "handle": "example" } }
  ],
  "tv": {
    "episodesDir": "tv/episodes",
    "shows": { "weekly": "The weekly report" }
  },
  "livestream": { "youtube": "example" },
  "projects": { "reportFile": "projects.md" },
  "chat": {
    "defaultProvider": "anthropic",
    "providers": {
      "together": { "models": [{ "id": "example-org/example-model", "label": "Example model" }] }
    }
  }
}
