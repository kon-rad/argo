# Vault settings and keys. Copy to .env (gitignored) and fill in what you use.
# Agents load it with: set -a; . ./.env; set +a

# ---- Second Brain app (see .secondbrain/docs/configuration.md) ----
# Optional modules, comma separated: projects, org, agents, usage, map, tv, voice, livestream, ring, social, chat
# (see .secondbrain/docs/modules.md)
MODULES=
OWNER_NAME=owner
# DEV_LOG_PATH=Projects/README.md
# DOCS_PATH=Projects/README.md
# TOGETHER_API_KEY=            # semantic search, and a chat provider
# chat module: a provider is offered when its key is set (or run Ollama locally)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# Optional reranker for the chat's retrieval (Cohere-compatible /rerank endpoint)
# RERANK_URL=https://api.together.xyz/v1
# RERANK_API_KEY=
# RERANK_MODEL=Salesforce/Llama-Rank-V1

# Instagram Unified Login metrics (server deployment with social module).
# PUBLIC_ORIGIN=https://brain.example.com
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_LOGIN_CONFIG_ID=
# SOCIAL_TOKEN_ENC_KEY=

# ---- Deploying the app to a server (.secondbrain/app/deploy/deploy.sh) ----
# DEPLOY_HOST=my-server        # ssh destination with root
# DEPLOY_PUBLIC_HOST=brain.example.com
# DEPLOY_VAULT_DIR=/srv/vault
# DEPLOY_APP_USER=secondbrain
# DEPLOY_NO_ROLLBACK=1         # leave a deploy in place when it does not come up (default: put the previous build back)

# ---- Vault sync (.secondbrain/docs/sync.md): this machine's role in `secondbrain-vault sync` ----
# SYNC_ROLE=owner              # owner: you edit here, a conflict stops and alerts. agent: a server, a conflict keeps both versions
# SYNC_MACHINE=                # name in sync commit messages (default: hostname)
# SYNC_INTERVAL_MIN=60         # used by `sync install`
# SYNC_CONFLICTS=              # stop | both (default by role)
# SYNC_ALERT=desktop           # desktop | log | https://... (POST, JSON {"title","text"})
# DEPLOY_VAULT_SYNC=1          # deploy.sh: install the server's sync timer (role agent, every 15 min)

# ---- Agent hooks ----
# DEV_LOG_INDEX=Projects/README.md   # the gate asks agents to link new dev logs here

# Gemini image model for `cli-org avatar generate` (agent portraits, docs/org-yaml.md "Avatars"). Unset: the command refuses.
# GEMINI_API_KEY=

# Optional Hiring Desk. All values stay unset unless desk is enabled.
# Existing deployments must select their payment interface explicitly.
# DESK_DOMAIN=public-desk
# DESK_CHAIN_ID=5042002
# DESK_PAYMENT_INTERFACE=arc:testnet:erc20-usdc:transfer:v1
# DESK_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# DESK_RPC_URL=https://rpc.example.com
# DESK_PUBLIC_ORIGIN=https://client.example.com
# Trusted server-only ES module exporting createDeskRuntime. Not a browser URL.
# DESK_RUNTIME_MODULE=/srv/example/desk-runtime.mjs

# Automatic review is disabled by default. A separate trusted host worker uses its own service env:
# REVIEW_DB_URL=postgres://review_service@127.0.0.1/secondbrain
# Never give the worker login or deployment credentials to builders. See docs/automatic-review.md.

# Optional native Codex conversation collector. Pass these to the Mac usage installer.
# CODEX_HOME=~/.codex
# USAGE_HOST=laptop-a
# USAGE_PUSH_HOST=my-server
# USAGE_PUSH_STATE=~/.local/share/secondbrain

# ---- Advanced local overrides (normally set by installers or agent runtimes) ----
# SECONDBRAIN_SETTINGS=secondbrain.json
# PROJECTS_BY=operator
# PLAN_USAGE_LOG=~/.local/share/secondbrain/plan-usage.ndjson
# CLAUDE_PROJECTS_DIR=~/.claude/projects
# CC_RUNS_DIR=~/cc-runs
# SECONDBRAIN_TELEGRAM_DIR=~/.local/share/secondbrain/telegram
# CLAUDE_BIN=claude
# CREDITS_KEYS_FILE=~/.config/secondbrain/credits.env
# FAL_BILLING_KEY=
# BASE_RPC_URL=https://mainnet.base.org
# LIVESTREAM_YOUTUBE=
# LIVESTREAM_TWITCH=
# LIVESTREAM_KICK=
# LIVESTREAM_PUBLIC_DIR=/var/lib/secondbrain-public
