# Vault settings and keys. Copy to .env (gitignored) and fill in what you use.
# Agents load it with: set -a; . ./.env; set +a

# ---- Second Brain app (see .secondbrain/docs/configuration.md) ----
# Optional modules, comma separated: projects, org, agents, usage, map, tv, voice, livestream, ring, social, chat
# (see .secondbrain/docs/modules.md)
MODULES=
OWNER_NAME=owner
# DEV_LOG_PATH=Projects/README.md
# DOCS_PATH=Projects/README.md
# TOGETHER_API_KEY=            # semantic search, and a chat provider
# chat module: a provider is offered when its key is set (or run Ollama locally)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# Optional reranker for the chat's retrieval (Cohere-compatible /rerank endpoint)
# RERANK_URL=https://api.together.xyz/v1
# RERANK_API_KEY=
# RERANK_MODEL=Salesforce/Llama-Rank-V1

# ---- Deploying the app to a server (.secondbrain/app/deploy/deploy.sh) ----
# DEPLOY_HOST=my-server        # ssh destination with root
# DEPLOY_PUBLIC_HOST=brain.example.com
# DEPLOY_VAULT_DIR=/srv/vault
# DEPLOY_APP_USER=secondbrain
# DEPLOY_NO_ROLLBACK=1         # leave a deploy in place when it does not come up (default: put the previous build back)

# ---- Agent hooks ----
# DEV_LOG_INDEX=Projects/README.md   # the gate asks agents to link new dev logs here
