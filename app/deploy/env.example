# /etc/secondbrain/env on the server: owned root:<app user>, mode 640. Never committed.
DEPLOYMENT=server
# The browser-visible origin: https:// plus the domain or IP Caddy serves.
PUBLIC_ORIGIN=https://brain.example.com
# The vault checkout on the server (kept current by your git sync).
VAULT_ROOT=/srv/vault
DATABASE_URL=postgres:///secondbrain?host=/var/run/postgresql
PORT=5123
# Rescan + re-embed every N minutes (0 = never).
SCAN_INTERVAL_MINUTES=30
# Vault sync timer (installed by deploy.sh when DEPLOY_VAULT_SYNC=1 on your machine): the unit
# sets SYNC_ROLE=agent; override here if you must. SYNC_ALERT is `log` by default on a server.
# SYNC_ALERT=https://example.com/hook
# Optional features, comma separated: ring, agents, projects, org, board, usage, map, tv,
# livestream, social, chat (voice is local only). deploy.sh installs each module's timers.
MODULES=
# Your name in the authenticator app and on the Agents board.
OWNER_NAME=owner
# Vault notes the nav links to (vault-relative); leave unset to hide the link.
# DEV_LOG_PATH=Projects/dev-log/README.md
# DOCS_PATH=Projects/docs/README.md

# From `secondbrain auth-setup` (run it on your own machine, paste the output here).
AUTH_PASSWORD_HASH=
AUTH_TOTP_SECRET=

# For semantic search (Together AI). Without it, a local Ollama is tried. Also a chat provider.
TOGETHER_API_KEY=

# chat module: a provider is offered in the app when its key is set.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# Optional reranker for the chat's retrieval (a Cohere-compatible /rerank endpoint and its model).
# RERANK_URL=https://api.together.xyz/v1
# RERANK_API_KEY=
# RERANK_MODEL=Salesforce/Llama-Rank-V1

# Agent archive: values of secret-named variables (KEY, TOKEN, SECRET, PASSWORD...) in
# this environment are redacted from transcripts before they are stored. List more env
# files whose values should be redacted too (comma separated), e.g. an agent's own .env.
# REDACT_ENV_FILES=

# Optional: `b2store serve` for big files that live only in Backblaze B2.
# B2_SERVE_URL=http://127.0.0.1:5124

# agents module: the agent-hub that serves Claude chats (and the Hermes kanban board, until the board module replaces it).
# AGENT_HUB_URL=http://127.0.0.1:5140
# AGENT_HUB_TOKEN=
# agents module: `zen-agent serve`, the zen-agent chat host (zen-agent/README.md, "serve"), behind /api/zen. The token is
# the same string as the serve process's ZEN_SERVE_TOKEN; it never reaches the browser.
# ZEN_AGENT_URL=http://127.0.0.1:8791
# ZEN_AGENT_TOKEN=

# board module: the kanban record in the engine (/board, cli-board). A claimed card's lease, in minutes, before the
# board takes it back when the worker stops heartbeating.
# BOARD_LEASE_MINUTES=60
# While the Hermes board still runs the bots: mirror every card the engine makes into it (hermes kanban on this machine).
# BOARD_HERMES_PROJECTION=off
# On a machine that is not the server (a laptop, another agent box): cli-board reaches the board over HTTPS as the roster
# member a token names. Mint one on the server with `cli-board token create <agent> --label "<where it runs>"`.
# BOARD_URL=https://brain.example.com
# BOARD_TOKEN=

# projects module: read-only bearer token for a kiosk's Projects panel
# (GET /api/feed/projects). deploy.sh generates it on first run.
# PROJECTS_FEED_TOKEN=

# org module: your name on the agent message board (the human agent).
# ORG_OWNER=owner
# The kanban assignee for vault work (a Claude Code session on your machine, never a bot).
# ORG_VAULT_ASSIGNEE=vault-session
# Runs one agent session carries before the next wake starts fresh (1: never resume).
# ORG_SESSION_MAX_RUNS=3
# A card that keeps waking its bot: re-wakes allowed in 24 h, and the first wait between them (doubles).
# ORG_TASK_WAKE_RETRIES=2
# ORG_TASK_WAKE_BACKOFF_MINUTES=15
# Extra path prefixes `cli-org recall` never returns from the vault (comma-separated). CURRENT/ and Areas/Finance/ are always excluded.
# ORG_RECALL_EXCLUDE=
# Cosine floor for vault hits only the vector branch found (0.25 cuts nothing; see docs/memory.md before raising it).
# ORG_RECALL_MIN_SIMILARITY=0.25
# The cheap model a bot's reflect step calls after each wake (docs/agent-memory.md): cheap (the local Ollama
# first, then your default chat provider), off (episodes only, no model call), or <provider>/<model>.
# ORG_REFLECT_MODEL=cheap
# Reflect model calls allowed per day across every bot.
# ORG_REFLECT_MAX_PER_DAY=200
# The local day for "one routine per day" and the dispatcher's quiet hours (an IANA zone name).
# ORG_TZ=UTC
# The engine's dispatcher for bots whose roster runtime is zen-agent (docs/zen-runtime.md). on installs its timer.
# ORG_DISPATCH=off
# ORG_DISPATCH_TICK_SECONDS=120
# Bots run at the same time; local hours with no runs (HH-HH); tokens all bots may spend per local day (0: no cap).
# ORG_DISPATCH_PARALLEL=2
# ORG_DISPATCH_QUIET=01-07
# ORG_DISPATCH_DAILY_TOKENS=0
# The zen-agent command (on the app user's PATH, or an absolute path), and where it writes traces.
# ORG_ZEN_COMMAND=zen-agent
# ZEN_SESSIONS_DIR=/srv/vault/.zen/sessions
# The classify step in front of a wake (Jev): none | openrouter (OPENROUTER_API_KEY) | typesafe (TYPESAFE_API_KEY).
# CLASSIFY_PROVIDER=none
# CLASSIFY_DAILY_TOKENS=2000000
# TYPESAFE_API_KEY=

# social module: LinkedIn is the first provider. Register an app at
# developer.linkedin.com (products: "Sign In with LinkedIn using OpenID Connect",
# "Share on LinkedIn"); redirect URI is <SOCIAL_REDIRECT_BASE_URL>/api/social/accounts/linkedin/callback.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# Defaults to PUBLIC_ORIGIN; set only if the OAuth callback needs a different host.
# SOCIAL_REDIRECT_BASE_URL=
# 32-byte key (64 hex chars) encrypting stored OAuth tokens. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# SOCIAL_TOKEN_ENC_KEY=
# Buffer relay (Instagram, YouTube Shorts, X): a personal key from Buffer,
# Settings > API. Then run `cli-social connect-buffer` once.
# BUFFER_API_KEY=
# Public base URL Buffer fetches post media from (it has no upload); must be
# reachable from the internet. Defaults to SOCIAL_REDIRECT_BASE_URL.
# SOCIAL_MEDIA_BASE_URL=
# X's weighted length limit: 280 on a free X account, 25000 on Premium.
# SOCIAL_X_MAX_CHARS=280
