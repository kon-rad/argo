#!/usr/bin/env bash
# cli-projects on the app user's PATH (installed to ~/.local/bin by deploy.sh). PROJECTS_BY names the writer.
set -eo pipefail   # no -u: the env file holds bcrypt hashes with $-sequences the shell would flag
set -a; . /etc/secondbrain/env; set +a
exec node --no-warnings @APP_DIR@/server/dist/cli-projects.js "$@"
