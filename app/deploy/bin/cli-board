#!/usr/bin/env bash
# cli-board on the app user's PATH (installed to ~/.local/bin by deploy.sh), so an agent's
# `Bash(cli-board *)` tool rule matches. Identity comes from ORG_AGENT in the caller's environment
# (the row-level-security role with SB_ORG_DB_URL), or from BOARD_URL + BOARD_TOKEN on another machine.
set -eo pipefail   # no -u: the env file holds bcrypt hashes with $-sequences the shell would flag
set -a; . /etc/secondbrain/env; set +a
exec node --no-warnings @APP_DIR@/server/dist/cli-board.js "$@"
