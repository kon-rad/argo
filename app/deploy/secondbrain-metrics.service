[Unit]
Description=Second Brain: collect the brain map's numbers (followers, fund Safe) and social post stats
After=network-online.target postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
# Public pages, plus the socialMetrics API collectors when configured
# (YOUTUBE_API_KEY, Instagram tokens stored encrypted with SOCIAL_TOKEN_ENC_KEY).
# Each account fails on its own; see docs/social-metrics.md.
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=/etc/secondbrain/env
ExecStart=/usr/bin/node --no-warnings server/dist/cli-metrics.js collect
# Exit 2 = some sources failed, the rest were written; not a unit failure.
SuccessExitStatus=2
TimeoutStartSec=180
PrivateTmp=true
NoNewPrivileges=true
