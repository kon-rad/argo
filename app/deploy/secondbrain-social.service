[Unit]
Description=Second Brain: publish due social posts, check for accounts needing reauth
After=network-online.target postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
# As the app user (owns the database and the encryption key in EnvironmentFile).
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=/etc/secondbrain/env
ExecStart=/usr/bin/node --no-warnings server/dist/cli-social.js
# Exit 2 = at least one post failed to publish; not a unit failure (it retries next minute).
SuccessExitStatus=2
# A pass starts no new post after 40 s; this covers one post's uploads after that
# (4 images x (20 s init + 30 s upload) + the post). The timer doesn't start a
# second run while one is active.
TimeoutStartSec=300
PrivateTmp=true
NoNewPrivileges=true
