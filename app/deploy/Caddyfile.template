# Second Brain behind Caddy. deploy.sh renders this to /etc/caddy/Caddyfile,
# filling in the public host (a domain or a bare IP), the global options (only
# when a bare IP is served), the public-files block (only with the livestream
# module), a redirect site (only when DEPLOY_REDIRECT_FROM is set) and the
# extra import lines (only when EXTRA_CADDY_IMPORT is set).
#
# For a bare IP, Let's Encrypt issues IP certificates only under the
# `shortlived` profile (~6-day certs); Caddy >= 2.11.4 requests and renews them.
# Port 80 must stay open for the ACME challenge and the HTTP->HTTPS redirect.
@GLOBAL_OPTIONS@

https://@PUBLIC_HOST@ {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Matches the app's 6 MB limit for saving a note, with headroom.
	request_body {
		max_size 8MB
	}
@PUBLIC_FILES@
	# The app listens on loopback only; this is the one way in.
	handle {
		reverse_proxy 127.0.0.1:5123
	}

	log {
		output file /var/log/caddy/secondbrain.log
	}
}
@REDIRECT@
@EXTRA_IMPORT@
