{
  "name": "secondbrain-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["shared", "server", "web"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm -w server run dev",
    "dev:web": "npm -w web run dev",
    "build": "npm run build:server && npm run build:web",
    "start": "node server/dist/index.js",
    "test": "vitest run",
    "migrate": "node-pg-migrate -m db/migrations -j sql",
    "migrate:up": "npm run migrate -- up",
    "scan": "npm -w server run scan",
    "build:shared": "npm -w @secondbrain/desk-contracts run build",
    "build:server": "npm -w server run build",
    "build:web": "npm -w web run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "node-pg-migrate": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
