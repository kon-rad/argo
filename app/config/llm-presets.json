{
  "$comment": "Chat providers and the models the app offers for each. A provider is listed in the app only when its key is set (see docs/configuration.md). A vault adds or overrides models in secondbrain.json under chat.providers; edit this file only to change what every install starts with.",
  "defaultProvider": "anthropic",
  "systemPrompt": "You are the assistant of a personal second brain: a vault of markdown notes the owner keeps. Answer from the passages you are given, cite them as [1], [2] after the sentences they support, and say plainly when the notes do not cover the question instead of guessing. Keep answers short and concrete; use the owner's own terms and note titles.",
  "providers": {
    "anthropic": {
      "label": "Anthropic",
      "protocol": "anthropic",
      "env": "ANTHROPIC_API_KEY",
      "baseUrl": "https://api.anthropic.com",
      "default": "claude-opus-5-5",
      "models": [
        { "id": "claude-opus-5-5", "label": "Claude Opus 5.5" },
        { "id": "claude-sonnet-5-5", "label": "Claude Sonnet 5.5" },
        { "id": "claude-haiku-5-5", "label": "Claude Haiku 5.5" }
      ]
    },
    "openai": {
      "label": "OpenAI",
      "protocol": "openai",
      "env": "OPENAI_API_KEY",
      "baseUrl": "https://api.openai.com/v1",
      "default": "gpt-5.2",
      "models": [
        { "id": "gpt-5.2", "label": "GPT-5.2" },
        { "id": "gpt-5.2-mini", "label": "GPT-5.2 mini" }
      ]
    },
    "together": {
      "label": "Together AI",
      "protocol": "openai",
      "env": "TOGETHER_API_KEY",
      "baseUrl": "https://api.together.xyz/v1",
      "default": "deepseek-ai/DeepSeek-V4.1-Flash",
      "models": [
        { "id": "deepseek-ai/DeepSeek-V4.1-Flash", "label": "DeepSeek V4.1 Flash" },
        { "id": "meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8", "label": "Llama 4 Maverick" },
        { "id": "Qwen/Qwen3-235B-A22B-Instruct-2507-tput", "label": "Qwen3 235B" }
      ]
    },
    "openrouter": {
      "label": "OpenRouter",
      "protocol": "openai",
      "env": "OPENROUTER_API_KEY",
      "baseUrl": "https://openrouter.ai/api/v1",
      "default": "anthropic/claude-sonnet-5.5",
      "models": [
        { "id": "anthropic/claude-sonnet-5.5", "label": "Claude Sonnet 5.5 (OpenRouter)" },
        { "id": "openai/gpt-5.2", "label": "GPT-5.2 (OpenRouter)" },
        { "id": "google/gemini-3-pro", "label": "Gemini 3 Pro (OpenRouter)" }
      ]
    },
    "ollama": {
      "label": "Ollama (local)",
      "protocol": "openai",
      "env": null,
      "baseUrl": "http://127.0.0.1:11434/v1",
      "default": "llama3.1",
      "models": [
        { "id": "llama3.1", "label": "Llama 3.1" },
        { "id": "qwen3", "label": "Qwen3" },
        { "id": "gemma3", "label": "Gemma 3" }
      ]
    }
  }
}
