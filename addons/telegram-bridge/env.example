# telegram-bridge settings. Copy to ~/.zen/telegram-bridge.env (mode 600), outside the vault, and let systemd load it.
# Never commit the filled-in file.

# From @BotFather. Use a bot that no other process polls: a token has exactly one poller.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs (ask @userinfobot). Empty means the bridge refuses to start.
TELEGRAM_ALLOWED_USERS=

# Which agent answers. Both optional; zen.json supplies the defaults.
ZEN_PERSONA=
ZEN_MODEL=
# Tool sets for Telegram runs, narrower than your desk session's. Empty uses zen.json's list.
ZEN_TOOLS=fs,skills,knowledge,kanban,org

# Cost controls. A run stops at either limit and says so in the chat.
BRIDGE_MAX_TURNS=25
BRIDGE_MAX_TOKENS=200000
# A conversation is replayed on every message, so it starts fresh after this many runs. /new does it by hand.
BRIDGE_MAX_RUNS=20
# 1 adds "[N tokens, M turns]" under every answer.
BRIDGE_FOOTER=1

# Paths. The vault is where zen-agent finds AGENTS.md and zen.json.
BRIDGE_WORKDIR=/path/to/vault
ZEN_AGENT_BIN=zen-agent
BRIDGE_RUN_TIMEOUT=600
