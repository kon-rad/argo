{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true, "skipLibCheck": true,
    "declaration": true, "sourceMap": true, "rootDir": "server", "outDir": "dist/server", "types": ["node"]
  },
  "include": ["server/**/*.ts"],
  "exclude": ["server/**/*.test.ts", "server/**/*vitest*.ts", "server/desk/manifest.ts"]
}
