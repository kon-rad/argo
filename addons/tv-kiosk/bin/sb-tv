#!/bin/bash
# Show Second Brain pages full screen on a TV: one Chromium kiosk, one tab per page.
# With more than one page it rotates through them, reloading each as it comes up
# so the data is fresh. Pages live in ~/.config/sb-tv/pages, one per line:
#   <url> [seconds]        (seconds defaults to SB_TV_SECONDS, 60; 0 = stay, never reload)
# TV mode (`sb-tv tv <url>`) shows one page, such as a video channel, and never touches it:
# no rotation, no F5, so playback is never cut. `sb-tv dashboard` restores the rotation.
# Ctrl+Alt+M (labwc keybind, written by install.sh) runs `sb-tv toggle`: open the kiosk, or close it.
# Ctrl+Alt+N runs `sb-tv browse`: swap the kiosk for a normal full-screen Chromium on the same
# profile (logged in, F11 shows the URL bar, the app's navigation works), and back again.
# Usage: sb-tv [start|stop|toggle|browse|reload|status|pages|url <url>...|add <url> [seconds]|tv <url>|dashboard|autostart]
set -u
CONF="${SB_TV_CONF:-$HOME/.config/sb-tv}"
PAGES="$CONF/pages"
SAVED="$CONF/pages.dashboard"   # the rotation, kept while TV mode is on
BROWSE="$CONF/browse"            # present while browse mode is on
PROFILE="$CONF/chromium-profile"   # its own profile, so the app login survives reboots
DEFAULT_SECONDS="${SB_TV_SECONDS:-60}"
# A single page is still reloaded this often (seconds) so it never goes stale. 0 = never.
REFRESH="${SB_TV_REFRESH:-300}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"

# Print the pages file as "url<TAB>seconds", skipping blanks and comments.
pages(){
  [ -r "$PAGES" ] || return 0
  awk -v d="$DEFAULT_SECONDS" '/^[[:space:]]*(#|$)/{next} {print $1 "\t" ($2 ~ /^[0-9]+$/ ? $2 : d)}' "$PAGES"
}
browser_running(){ pgrep -u "$(id -u)" -f -- "--user-data-dir=$PROFILE" >/dev/null; }
rotator_running(){ pgrep -u "$(id -u)" -f -- "sb-tv [_]rotate" >/dev/null; }
key(){ command -v wtype >/dev/null && wtype "$@" 2>/dev/null; }
# Send sound to the TV: the Pi defaults to its headphone jack, so pick the HDMI sink if there is one.
hdmi_audio(){
  command -v wpctl >/dev/null || return 0
  local id
  id=$(wpctl status 2>/dev/null | sed -n '/Sinks:/,/Sources:/p' | grep -i hdmi | grep -oE '[0-9]+\.' | head -1 | tr -d .)
  [ -n "$id" ] && wpctl set-default "$id" && wpctl set-volume "$id" 1.0
}
in_tv_mode(){ [ -r "$SAVED" ]; }
in_browse(){ [ -e "$BROWSE" ]; }
# Where browse mode opens: the first page without its kiosk=1, so the app shows its navigation.
browse_url(){ pages | head -1 | cut -f1 | sed -E 's/([?&])kiosk=1(&|$)/\1/; s/[?&]$//'; }

# launch <--kiosk|--start-fullscreen> <url>...
launch(){
  local mode=$1; shift
  chromium_bin=$(command -v chromium || command -v chromium-browser)
  # stop() kills Chromium, which then offers "Restore pages?"; mark the last exit as clean.
  sed -i 's/"exit_type":"Crashed"/"exit_type":"Normal"/; s/"exited_cleanly":false/"exited_cleanly":true/' \
    "$PROFILE/Default/Preferences" 2>/dev/null || true
  # Autoplay with sound: a kiosk has no mouse, so nobody can click to unmute a video.
  nohup "$chromium_bin" --user-data-dir="$PROFILE" --ozone-platform=wayland "$mode" \
    --autoplay-policy=no-user-gesture-required \
    --noerrdialogs --disable-infobars --disable-session-crashed-bubble \
    --no-first-run --password-store=basic --check-for-update-interval=31536000 \
    ${SB_TV_CHROMIUM_FLAGS:-} "$@" >/dev/null 2>&1 &
}

start(){
  browser_running && return 0
  rm -f "$BROWSE"
  mapfile -t urls < <(pages | cut -f1)
  if [ "${#urls[@]}" -eq 0 ]; then echo "no pages in $PAGES (sb-tv add <url>)"; return 1; fi
  hdmi_audio || true
  launch --kiosk "${urls[@]}"
  rotator_running || nohup "$0" _rotate >/dev/null 2>&1 &
}
stop(){
  pkill -u "$(id -u)" -f -- "sb-tv [_]rotate" || true
  pkill -u "$(id -u)" -f -- "--user-data-dir=$PROFILE" || true
  rm -f "$BROWSE"
  sleep 1
}
# Browse mode: the same profile as a normal browser, full screen, no rotator.
browse(){
  local url
  url=$(browse_url)
  [ -n "$url" ] || { echo "no pages in $PAGES (sb-tv add <url>)"; return 1; }
  stop
  mkdir -p "$CONF"; touch "$BROWSE"
  hdmi_audio || true
  launch --start-fullscreen "$url"
}

# Wait the current page's time, then Ctrl+Tab to the next tab and reload it.
# One page: just reload it every REFRESH seconds. A page whose time is 0 is never
# left or reloaded (TV mode), so a video on it plays through.
rotate(){
  sleep 15   # let Chromium open its tabs
  local i=0
  while browser_running; do
    mapfile -t secs < <(pages | cut -f2)
    local n=${#secs[@]}
    [ "$n" -eq 0 ] && { sleep 30; continue; }
    if [ "${secs[$((i % n))]}" = 0 ]; then
      sleep 60; continue
    fi
    if [ "$n" -eq 1 ]; then
      [ "$REFRESH" -gt 0 ] || { sleep 60; continue; }
      sleep "$REFRESH"; key -k F5
    else
      sleep "${secs[$((i % n))]}"
      key -M ctrl -k Tab -m ctrl
      i=$(( (i + 1) % n ))
      sleep 1; key -k F5
    fi
  done
}

case "${1:-start}" in
  start)     start ;;
  stop)      stop ;;
  toggle)    if browser_running; then stop; else start; fi ;;
  browse)    if in_browse; then stop; start; else browse; fi ;;
  reload)    stop; start ;;
  autostart) sleep 5; start ;;
  _rotate)   rotate ;;
  status)    browser_running && echo running || echo stopped
             rotator_running && echo "rotator: on" || echo "rotator: off"
             if in_browse; then echo "mode: browse"; elif in_tv_mode; then echo "mode: tv"; else echo "mode: dashboard"; fi
             pages | sed 's/^/page: /' ;;
  tv)        [ $# -ge 2 ] || { echo "usage: sb-tv tv <url>"; exit 1; }
             mkdir -p "$CONF"
             in_tv_mode || { [ -r "$PAGES" ] && cp "$PAGES" "$SAVED" || : > "$SAVED"; }
             echo "$2 0" > "$PAGES"; stop; start ;;
  dashboard) in_tv_mode || { echo "already in dashboard mode"; exit 0; }
             if [ -s "$SAVED" ]; then mv "$SAVED" "$PAGES"; else rm -f "$SAVED"; fi
             stop; start ;;
  pages)     pages ;;
  url)       shift; [ $# -gt 0 ] || { echo "usage: sb-tv url <url> [<url>...]"; exit 1; }
             mkdir -p "$CONF"; printf '%s\n' "$@" > "$PAGES"; stop; start ;;
  add)       [ $# -ge 2 ] || { echo "usage: sb-tv add <url> [seconds]"; exit 1; }
             mkdir -p "$CONF"; echo "$2 ${3:-}" >> "$PAGES"; stop; start ;;
  *) echo "usage: sb-tv [start|stop|toggle|browse|reload|status|pages|url <url>...|add <url> [seconds]|tv <url>|dashboard]"; exit 1 ;;
esac
