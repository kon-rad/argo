{
  "name": "zen-agent",
  "version": "0.1.0",
  "description": "A minimal agent harness on the pi agent core: personas from an org roster, skills, swappable providers, a kanban board and a knowledge base as tools, budgets, traces and an in-process guard.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "zen-agent": "dist/src/cli.js" },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": ["dist/src", "README.md", "zen.example.json"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "start": "node dist/src/cli.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "typebox": "1.3.27",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
