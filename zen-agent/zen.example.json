{
  "$comment": "zen-agent configuration. Copy to zen.json next to your vault (or ~/.zen/zen.json). Paths are relative to the vault. Secrets are never here: name the environment variable that holds them. The model is the cheap default for bot wakes (OPENROUTER_API_KEY); openrouter/deepseek/deepseek-v4-flash is the alternative, and a persona's model field or --model overrides it per run.",
  "model": "openrouter/deepseek/deepseek-v4.1-flash",
  "thinking": "off",
  "vault": ".",
  "sessionsDir": ".zen/sessions",
  "rules": ["AGENTS.md"],
  "skills": [".agents/skills", "~/.zen/skills"],
  "persona": { "org": ".agents/org/org.json", "definitions": ".claude/agents", "memory": ".agents/org/memory" },
  "tools": ["fs", "shell", "skills", "knowledge", "kanban", "org", "subagent"],
  "budget": { "turns": 40, "tokens": 400000, "minutes": 30 },
  "context": {
    "cap": 0.6,
    "keepTurns": 6,
    "parts": { "rules": 6000, "persona": 3000, "playbook": 2000, "skills": 1500, "handoff": 500, "task": 4000 }
  },
  "guard": {
    "local": ".agents/guard.local.json",
    "log": "~/.cache/agent-guard.log",
    "hooks": {
      "preToolUse": [],
      "stop": ["python3 .secondbrain/harness/hooks/devlog_gate.py"]
    }
  },
  "shell": { "timeoutS": 120, "maxOutput": 12000 },
  "knowledge": { "kind": "secondbrain", "url": "http://127.0.0.1:3000", "headersEnv": "ZEN_SB_HEADERS" },
  "kanban": { "kind": "board", "url": "http://127.0.0.1:5123", "tokenEnv": "BOARD_TOKEN", "board": "exo" },
  "$kanban_alternatives": "{ \"kind\": \"cli\", \"command\": \"hermes\", \"board\": \"exo\" } for the Hermes board; { \"kind\": \"hub\", \"url\": \"http://127.0.0.1:5140\", \"tokenEnv\": \"AGENT_HUB_TOKEN\", \"board\": \"exo\" } for agent-hub",
  "org": { "command": "cli-org" },
  "providers": {
    "ollama": {
      "api": "openai-completions",
      "baseUrl": "http://127.0.0.1:11434/v1",
      "models": [{ "id": "qwen3:8b", "contextWindow": 32000, "maxTokens": 8000 }]
    }
  }
}
